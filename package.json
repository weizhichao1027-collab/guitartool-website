{
  "name": "guitartool-marketing-site",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "npm run build:pages",
    "build:pages": "GITHUB_PAGES=true next build && node scripts/finalize-static-html.mjs out",
    "audit:dependencies": "npm audit --registry=https://registry.npmjs.org --audit-level=high",
    "audit:pages": "node scripts/audit-static-site.mjs out",
    "generate:chords": "node scripts/generate-chord-pages.mjs",
    "notify:indexnow": "node scripts/submit-indexnow.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next"
  },
  "dependencies": {
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.19.19",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.3",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  },
  "overrides": {
    "js-yaml": "4.3.2",
    "sharp": "0.35.4"
  },
  "type": "module"
}
